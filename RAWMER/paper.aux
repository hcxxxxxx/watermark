\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces LJSpeech~\cite  {ljspeech2017}, random 2000 (seed 2026); \emph  {nX} = additive Gaussian noise at $X$\,dB SNR; ``Ref.'' marks \emph  {informed} detectors, which read the clean reference. \textbf  {(a)} Bit accuracy: mel-domain methods (\texttt  {RAWMER}, MelShield~\cite  {jin2026}) carry 32 bits at matched clean PESQ\,$\approx $\,3.51, while AudioSeal~\cite  {san2024} and WavMark~\cite  {chen2023} (blind, forced-decoded) carry 16 bits on random 500---context, not matched competitors. \textbf  {(b)} Verification rate at two thresholds (a clip verifies when $\text  {ACC}\!\geq \!\tau $), with FPR the chance-level rate $\Pr [\text  {Bin}(32,\tfrac  12)\!\geq \!\lceil 32\tau \rceil ]$: $\tau \!=\!0.61$ buys VR at $31\times $ the FPR, so it is a bit-margin diagnostic only. Bold: best per column, ties included.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{4}{LJSpeech~\cite {ljspeech2017}, random 2000 (seed 2026); \emph {nX} = additive Gaussian noise at $X$\,dB SNR; ``Ref.'' marks \emph {informed} detectors, which read the clean reference. \textbf {(a)} Bit accuracy: mel-domain methods (\texttt {RAWMER}, MelShield~\cite {jin2026}) carry 32 bits at matched clean PESQ\,$\approx $\,3.51, while AudioSeal~\cite {san2024} and WavMark~\cite {chen2023} (blind, forced-decoded) carry 16 bits on random 500---context, not matched competitors. \textbf {(b)} Verification rate at two thresholds (a clip verifies when $\text {ACC}\!\geq \!\tau $), with FPR the chance-level rate $\Pr [\text {Bin}(32,\tfrac 12)\!\geq \!\lceil 32\tau \rceil ]$: $\tau \!=\!0.61$ buys VR at $31\times $ the FPR, so it is a bit-margin diagnostic only. Bold: best per column, ties included}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \texttt  {RAWMER} on HiFi-GAN~\cite  {kong2020}; \emph  {nX} = additive Gaussian noise at $X$\,dB SNR. \textbf  {(a)} Reference compression, ACC\,/\,VR at $\tau \!=\!0.75$ (random 2000; uint4 band is random 500); ``band'' stores the 40-bin watermark band, ``full'' all 80 bins, and a float32 band-only reference would occupy 87.5\,KB. \textbf  {(b)} Candidate count $C$, ACC (random 500); $C\!=\!1$ is differential encoding with a random bin-group pair, i.e.\ no selection. \textbf  {(c)} Desynchronization, ACC\,/\,VR (random 500).}}{4}{table.2}\protected@file@percent }
\newlabel{tab:compress}{{2}{4}{\texttt {RAWMER} on HiFi-GAN~\cite {kong2020}; \emph {nX} = additive Gaussian noise at $X$\,dB SNR. \textbf {(a)} Reference compression, ACC\,/\,VR at $\tau \!=\!0.75$ (random 2000; uint4 band is random 500); ``band'' stores the 40-bin watermark band, ``full'' all 80 bins, and a float32 band-only reference would occupy 87.5\,KB. \textbf {(b)} Candidate count $C$, ACC (random 500); $C\!=\!1$ is differential encoding with a random bin-group pair, i.e.\ no selection. \textbf {(c)} Desynchronization, ACC\,/\,VR (random 500)}{table.2}{}}
